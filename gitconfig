[include]
  path = ~/.gitconfig.local

[alias]
  c = commit -am
  s = status
  stat = status -sb
  co = checkout
  cob = checkout -b
  cof = "!git checkout $(git branch | fzf | sed 's/^..//')"
  amend = commit --amend
  fix = commit --fixup
  find = log --all -S
  fpush = push --force-with-lease
  hreset = reset --hard
  rbl = rebase -i - # rebase on last
  rbm = rebase -i main # rebase on main
  mgs = co staging && git pull && git merge - # merge branch into staging
  push = push --set-upstream origin $(git_current_branch)
  df = diff --color --color-words --abbrev
  diff- = diff HEAD~
  lg = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --
  lm = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(cyan)<%an>%Creset' --abbrev-commit --date=relative origin/$(git main)..HEAD`
  fixup = "!git log origin/main..HEAD -n 20 --pretty=format:'%h %s' --no-merges | fzf | cut -c -7 | xargs -o git commit --fixup"
  kill = branch -D
  subsume = "!f() { git reset --hard $1; git branch -D $1; }; f"
  cleanup = "!git fetch -p && git for-each-ref --format '%(refname:short) %(upstream:track)' | awk '$2 == \"[gone]\" {print $1}' | xargs -r git branch -D"

[branch]
  sort = -committerdate

[color]
  branch = auto
  diff = auto
  status = auto
  ui = true

[core]
  excludesfile = ~/.gitignore
  editor = vim
  pager = diff-so-fancy | less --tabs=4 -RF

[diff]
  compactionHeuristic = true
  # algorithm = histogram
  rename = copy
  check = true

[pager]
  color = true

[push]
  default = simple
  autoSetupRemote = true

[pull]
  rebase = true

[commit]
  verbose = true

[rebase]
  autosquash = true

[rerere]
  enabled = false

[help]
  autocorrect = 1

[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true

[interactive]
  diffFilter = diff-so-fancy --patch

[color "diff-highlight"]
  oldNormal = red bold
  oldHighlight = red bold 52
  newNormal = green bold
  newHighlight = green bold 22

[color "diff"]
  meta = 11
  frag = magenta bold
  func = 146 bold
  commit = yellow bold
  old = red bold
  new = green bold
  whitespace = red reverse

[safe]
  directory = /Users/smaust/qmk_userspace
